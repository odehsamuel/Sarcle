ATTESTER_A_PORT="5000"
ATTESTER_A_SECRET_KEY="S..."
ATTESTER_A_PUBLIC_KEY="G..."
STORAGE_DIR="attester-a/storage"

# Attester B (Rust Runner) Configuration
ATTESTER_B_SECRET_KEY="S..."
ATTESTER_B_PUBLIC_KEY="G..."

# Simulator / Device Keys
DEVICE_SECRET_KEY="S..."
DEVICE_PUBLIC_KEY="G..."

# Protocol Default Parameters
MAX_DIVERGENCE_BPS=500
CHALLENGE_TTL_SECS=300
TIMESTAMP_TOLERANCE_SECS=60
CHALLENGE_WINDOW_SECS=60
ARBITER_TIMEOUT_SECS=604800
